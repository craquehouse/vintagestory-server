# Git
.git
.gitignore

# Environment files at any depth (except examples): web/.env holds a developer's
# VITE_API_KEY, which Vite would otherwise build into the bundle
**/.env
**/.env.*
!**/.env.example

# Data directory (mounted at runtime)
data/

# Documentation
*.md
_bmad/
_bmad-output/
agentdocs/
docs/

# Development config
.mise.toml
.claude/
.cursor/
.vscode/

# Python artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
.ruff_cache/

# Node artifacts
node_modules/
.turbo/

# OS files
.DS_Store
Thumbs.db

# Test artifacts
coverage/
htmlcov/
.coverage
