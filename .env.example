# VintageStory Server Manager Configuration
# Copy this file to .env and update values as needed

# =============================================================================
# REQUIRED: API Authentication
# =============================================================================

# Admin API key for full access (start/stop server, manage mods, edit config)
# Generate a secure random string, e.g.: openssl rand -hex 32
VS_API_KEY_ADMIN=change-me-to-a-secure-random-string

# =============================================================================
# OPTIONAL: Additional Configuration
# =============================================================================

# Read-only API key for monitoring (view status, logs)
# Leave empty or commented out to disable monitor access
# VS_API_KEY_MONITOR=optional-monitor-key

# VintageStory game version to install
# Options: "stable", "unstable", or specific version like "1.21.3"
# Default: stable
# VS_GAME_VERSION=stable

# CORS for local development
# Options: comma separated origins "http://localhost:3000,https://my.app"
# Default: http://localhost:5173
# VS_CORS_ORIGINS=http://localhost:5173

# Enable debug logging (verbose output, human-readable logs)
# Set to "true" for development, "false" for production
# Default: false
# VS_DEBUG=false

# Data directory path (inside container)
# Default: /data
# Only change if you have a custom volume mount configuration
# VS_DATA_DIR=/data

# API key the web UI receives at runtime (served at /config.js)
# Must equal VS_API_KEY_ADMIN or VS_API_KEY_MONITOR; set it to the monitor key for a
# read-only web UI. Anyone who can load the web UI receives this key.
# Default: blank - the web UI uses the admin key
# VS_API_KEY=

# Web dev server only (just dev-web): put VITE_API_KEY and VITE_API_BASE_URL in
# web/.env (see web/.env.example). They are not used by the Docker image.

# UV link mode for dependency installation
# Options: "copy" (recommended for containers), "symlink" (faster rebuilds)
# Default: copy
# UV_LINK_MODE=copy
