# VintageStory Server Manager Configuration
# Copy this file to .env and update values as needed

# =============================================================================
# REQUIRED: API Authentication
# =============================================================================

# Admin API key for full access (start/stop server, manage mods, edit config)
# Generate a secure random string, e.g.: openssl rand -hex 32
VS_API_KEY_ADMIN=change-me-to-a-secure-random-string

# =============================================================================
# OPTIONAL: Additional Configuration
# =============================================================================

# Read-only API key for monitoring (view status, logs)
# Leave empty or commented out to disable monitor access
# VS_API_KEY_MONITOR=optional-monitor-key

# CORS for local development
# Options: comma separated origins "http://localhost:3000,https://my.app"
# Default: http://localhost:5173
# VS_CORS_ORIGINS=http://localhost:5173

# Enable debug logging (verbose output, human-readable logs)
# Set to "true" for development, "false" for production
# It also serves the API documentation at /docs, /redoc and /openapi.json and the
# RBAC test routes, so leave it off outside development.
# Default: false
# VS_DEBUG=false

# Level of the API's own log lines: DEBUG, INFO, WARNING or ERROR (any letter case)
# Unset: DEBUG with VS_DEBUG=true, INFO otherwise. VS_DEBUG still decides the rest
# (/docs, the test routes, the console format).
# The debug logging switch in the web UI gives DEBUG while it is on and returns to
# this level when it is turned off. uvicorn's own lines do not follow it.
# Any other value stops start-up.
# Default: unset
# VS_LOG_LEVEL=INFO

# How the web UI's pages are sent with their Content-Security-Policy
# Options: "enforce" (default; the pages also cannot be framed),
#          "report-only" (the browser only reports what the policy would block),
#          "off" (no policy). report-only and off also allow framing again.
# Use report-only or off only for a reverse proxy that injects scripts or styles,
# or a dashboard that frames the web UI. Any other value stops start-up.
# Default: enforce
# VS_CSP_MODE=enforce

# Base address of the mod database, for a mirror of the same database or for tests
# Mod listings come from <address>/api and mod files are downloaded from
# <address>/download; the game server runs those files, so use only a server you
# trust. It must serve the same database (the download cache and installed mods are
# kept by its IDs). Images still load only from moddbcdn.vintagestory.at and links
# to mod pages still go to mods.vintagestory.at. Another address is logged at every
# start as mod_db_url_overridden.
# Must be an https URL with a host and nothing else (no path, query, user name or
# password); http is accepted only with VS_DEBUG=true. Any other value stops start-up.
# Default: https://mods.vintagestory.at
# VS_MOD_DB_URL=https://mods.vintagestory.at

# Data directory path (inside container)
# Default: /data
# Only change if you have a custom volume mount configuration
# VS_DATA_DIR=/data

# Console lines sent when the console connects (default 100)
# VS_CONSOLE_HISTORY_LINES=100

# Free disk space (GB) below which the health check warns; 0 turns the fixed threshold off
# VS_DISK_SPACE_WARNING_THRESHOLD_GB=1.0

# Size (MB) of the downloaded-mods cache before old files are evicted; 0 turns eviction off
# VS_MOD_CACHE_MAX_SIZE_MB=500

# API key the web UI receives at runtime (served at /config.js)
# Required for the web UI. Unset or blank, the page shows "No API key configured"
# and the API logs web_api_key_not_set.
# Recommended: the monitor key (needs VS_API_KEY_MONITOR), for a read-only web UI:
#   VS_API_KEY=<your monitor key>
# The admin key gives the page full access, and the API logs web_api_key_is_admin_key
# on every start. Anyone who can load the web UI receives this key; to use the admin
# key, put the web UI behind a reverse proxy that authenticates.
# VS_API_KEY=

# Web dev server only (just dev-web): put VITE_API_KEY and VITE_API_BASE_URL in
# web/.env (see web/.env.example). They are not used by the Docker image.

# UV link mode for dependency installation
# Options: "copy" (recommended for containers), "symlink" (faster rebuilds)
# Default: copy
# UV_LINK_MODE=copy

# Time zone of the container (scheduled restarts follow it; log timestamps stay UTC)
# Default: UTC
# TZ=Europe/Berlin
